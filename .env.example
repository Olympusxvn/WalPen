PORT=3001
APP_ORIGIN=http://localhost:5173
MEMWAL_ACCOUNT_ID=
MEMWAL_PRIVATE_KEY=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
# Strict cosine-distance cutoff (0, 2]; default 0.7 is provisional. off disables
# relevance filtering, but missing/invalid distances still cannot enter context.
MEMWAL_RECALL_MAX_DISTANCE=0.7
# Keep 0 unless the selected relayer's durable deduplication/retention contract
# has been verified. Bounded replay window in ms, at most 86400000. See docs/WRITE-RECOVERY.md.
MEMWAL_IDEMPOTENCY_RETRY_WINDOW_MS=0
# A random 64-character hex secret. Back it up separately from the database.
DATA_ENCRYPTION_KEY=
# openai-compatible, gemini, or ollama. Blank disables chat honestly.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
# Optional invite code for a public pilot. Keep registration gated when deployed.
INVITE_CODE=
APP_MODE=development
