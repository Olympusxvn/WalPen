{
  "name": "walpen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "setup:local": "node scripts/local.mjs setup",
    "start:local": "node scripts/local.mjs start",
    "test": "tsx --test tests/*.test.ts && node --test tests/local.test.mjs",
    "test:cloud": "tsx --test tests/postgres.integration.ts",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "verify:public": "tsx scripts/verify-public.ts",
    "backup": "tsx scripts/backup.ts",
    "verify:walrus": "tsx scripts/verify-walrus.ts"
  },
  "dependencies": {
    "@mysten-incubation/memwal": "0.1.7",
    "@mysten/dapp-kit-react": "^2.1.37",
    "@mysten/sui": "^2.33.2",
    "@vercel/functions": "^3.9.9",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "telegraf": "^4.16.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/supertest": "^6.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.9.8",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": "24.x"
  }
}
